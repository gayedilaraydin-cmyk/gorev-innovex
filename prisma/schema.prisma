generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT // Müşteriden bekleniyor
  WAITING_TEAM // Ekipten bekleniyor
  DONE
  CANCELLED
  MEETING_NOTES
}

enum TaskSource {
  MANUAL // panelden elle eklendi
  AI // Claude/otomasyon tarafından eklendi
}

// Aciliyet × zorluk sınıflandırması — iş akışı durumundan (TaskStatus)
// bağımsız, opsiyonel bir öncelik etiketi. Bir görev örn. hem "Devam
// Ediyor" durumunda hem de "Acil ve Zor" öncelikli olabilir.
enum TaskPriority {
  URGENT // Acil
  NOT_URGENT // Acil Değil
  URGENT_HARD // Acil ve Zor
  URGENT_EASY // Acil ve Kolay
  NOT_URGENT_HARD // Acil Değil ve Zor
  NOT_URGENT_EASY // Acil Değil ve Kolay
}

// Bir müşteriye ait görev panosu. `slug`, gizli paylaşım linkini
// oluşturan, tahmin edilemeyecek kadar rastgele bir soneki olan
// benzersiz kimliktir (bkz. src/lib/slug.ts) — panonun kendisi hiçbir
// yerde listelenmez, yalnızca linke sahip olan görebilir.
model Board {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  createdAt    DateTime  @default(now())
  // Gizli linkin en son ne zaman açıldığı — sahip panelinde "inceleyen var"
  // göstergesini beslemek için (bkz. presence route'ları). Yaklaşık bir
  // sinyal: son heartbeat'ten belirli bir süre geçmediyse "aktif" sayılır.
  lastViewedAt DateTime?

  tasks Task[]

  @@map("boards")
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  source      TaskSource    @default(MANUAL)
  priority    TaskPriority?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, status])
  @@map("tasks")
}
